# Port to listen on (Render / Railway assign this automatically)
PORT=7000

# Public URL of your deployed service (e.g., https://my-stremio-subs.onrender.com)
# If left empty, the server will detect it automatically from request headers
HOST_URL=

# Groq Cloud API Key for ultra-fast Whisper AI transcription (Free: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
